# ── 模型提供商 ─────────────────────────────
# azure / qwen / deepseek / zhipu / openai / openai-compatible / volcengine
# 当前使用 DeepSeek-V4（OpenAI 兼容接口）
MODEL_PROVIDER=openai-compatible
LLM_API_KEY=你的DeepSeek_API_Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ── Embedding ──────────────────────────────
# local = 本地 BGE-M3（与已上传的 768 维向量一致，必须保持 local）
# 可选：azure / qwen / zhipu / openai / openai-compatible / volcengine
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=E:\\wu\\xidian\\job\\java\\agent\\models\\bge-m3
LOCAL_EMBEDDING_DEVICE=cpu

# ── 其他服务 ───────────────────────────────
OPENWEATHER_API_KEY=your_openweather_api_key_here
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=mysql+pymysql://root:1234@localhost:3306/campus_medical

# ── 向量数据库（Zilliz Cloud）────────────────
VECTOR_DB_TYPE=milvus
MILVUS_URI=https://你的集群.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
MILVUS_COLLECTION_NAME=campus_care_st
MILVUS_USER=你的Zilliz用户名
MILVUS_PASSWORD=你的Zilliz密码

# ── Langfuse 可观测性（可选）────────────────
# 注册：https://cloud.langfuse.com → Project Settings → API Keys
# 未配置或占位符时优雅降级，不影响运行
LANGFUSE_PUBLIC_KEY=你的_Public_Key
LANGFUSE_SECRET_KEY=你的_Secret_Key
LANGFUSE_HOST=https://us.cloud.langfuse.com   # US 区域；EU 为 https://cloud.langfuse.com

# ── 调试 ────────────────────────────────────
DEBUG=True
LOG_LEVEL=INFO
